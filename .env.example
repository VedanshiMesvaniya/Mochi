# ==============================
# Project Mochi - Environment Config
# Copy this file to .env and adjust values.
# Never commit your real .env file.
# ==============================

# --- Chat / local LLM ---
# Only used for open-ended messages the rule-based intent matcher doesn't
# recognize (see app/ai/intent.py, app/ai/llm.py). Requires Ollama
# (https://ollama.com) running locally with this model pulled; if it's
# not available, chat still works via a canned fallback reply.
# qwen2.5:1.5b (~0.9-1.0GB) is the default - noticeably smarter/more
# reliable at the structured JSON reply than qwen3:0.6b (~523MB) while
# staying under a 1GB footprint. Drop to qwen3:0.6b for very
# resource-constrained machines, or step up to qwen3:1.7b (~1.4GB) if you
# have the RAM to spare.
MOCHI_LLM_MODEL=qwen2.5:1.5b
MOCHI_LLM_TEMPERATURE=0.7
MOCHI_LLM_MAX_TOKENS=300

# --- Window behavior ---
MOCHI_ALWAYS_ON_TOP=true
MOCHI_AUTONOMOUS_BEHAVIOR=true

MOCHI_WINDOW_WIDTH=180
MOCHI_WINDOW_HEIGHT=180

# --- Humor ---
# Occasionally (once bored - see app/character/behavior.py's
# BORED_EXPRESSIONS - and rate-limited, see pet.py's HUMOR_MIN_INTERVAL_SECONDS)
# fetches a short joke from a small no-auth joke API (see app/ai/humor.py)
# instead of only ever picking from a fixed offline list. This is the one
# feature that reaches the open internet without an explicit integration
# like Google Calendar - set to false for a fully offline Mochi (jokes
# still happen, just always from the built-in offline list).
MOCHI_HUMOR_ENABLED=true

# --- Trend & meme-awareness (opt-in) ---
# Off by default. When enabled, Mochi periodically fetches:
#   - a handful of general trending headlines (app/humor/trend_fetcher.py)
#   - a handful of current meme post premises from general-audience meme
#     subreddits (app/humor/meme_fetcher.py) - this is what makes humor
#     feel "meme level" rather than just generically topical
# Both reduce whatever they fetch to a short paraphrased label/premise -
# never the raw headline/meme text - which LLM chat replies may casually
# riff on in their own words. A cached meme premise is preferred over a
# generic trend topic when both are available.
MOCHI_TREND_AWARENESS_ENABLED=false
MOCHI_TREND_FETCH_INTERVAL_HOURS=6

# --- Google Calendar (opt-in, off by default) ---
# Read-only unless MOCHI_GOOGLE_CALENDAR_WRITE_ENABLED is also true (V4 -
# spec section 22/23, Mode B). Off by default: with MOCHI_GOOGLE_CALENDAR_ENABLED
# false (or unset), Mochi never talks to Google at all. Turning it on
# requires:
#   1. pip install -r requirements-calendar.txt
#   2. An OAuth "Desktop app" client secret from Google Cloud Console,
#      saved as config/google_credentials.json (never commit this file -
#      see .gitignore)
#   3. Saying "connect my calendar" to Mochi once, to complete the
#      one-time browser consent flow (token cached at config/token.json,
#      also gitignored)
# See app/calendar/google_calendar.py's module docstring for full setup
# details, and README's Calendar section.
MOCHI_GOOGLE_CALENDAR_ENABLED=false
# Widens the OAuth scope from read-only to calendar.events so Mochi can
# create/cancel events - but ONLY after you explicitly say "yes" to each
# individual proposed action in chat (see app/ai/chat_engine.py). If you
# already connected in read-only mode, turning this on requires saying
# "connect my calendar" again to upgrade the granted permission.
MOCHI_GOOGLE_CALENDAR_WRITE_ENABLED=false
MOCHI_GOOGLE_CLIENT_SECRET_FILENAME=google_credentials.json
MOCHI_GOOGLE_TOKEN_FILENAME=token.json

# --- Logging ---
MOCHI_LOG_LEVEL=INFO
