# ==============================
# Project Mochi - Environment Config
# Copy this file to .env and adjust values.
# Never commit your real .env file.
# ==============================

# --- AI / LLM (Phase 2+) ---
MOCHI_LLM_MODEL=qwen3:0.6b
MOCHI_LLM_TEMPERATURE=0.7
MOCHI_LLM_MAX_TOKENS=300

# --- Voice (Phase 4+) ---
MOCHI_TTS_ENABLED=true
MOCHI_STT_ENABLED=true

# --- Memory (Phase 5+) ---
MOCHI_MEMORY_ENABLED=true
MOCHI_CONVERSATION_HISTORY_LENGTH=20

# --- Calendar (Phase 7/8) ---
MOCHI_GOOGLE_CALENDAR_ENABLED=false

# --- General behavior ---
MOCHI_START_WITH_WINDOWS=false
MOCHI_ALWAYS_ON_TOP=true
MOCHI_AUTONOMOUS_BEHAVIOR=true

# --- Window ---
MOCHI_WINDOW_WIDTH=180
MOCHI_WINDOW_HEIGHT=180

# Sprite playback speed. Kept low so Mochi reads as a character moving,
# not a fast image flicker. Raise it if your animation frames are subtle.
MOCHI_ANIMATION_FPS=4

# --- Logging ---
MOCHI_LOG_LEVEL=INFO
